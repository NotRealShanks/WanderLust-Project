<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
    }
    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid lightgrey;
        border-radius: 1rem;
        height: 3.25rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }

    .filter-link {
        text-decoration: none;
        color: inherit;
    }

    .filter.active {
        opacity: 1;
        border-bottom: 2px solid #222;
    }

    .no-results {
        text-align: center;
        margin-top: 4rem;
        opacity: 0.7;
    }

    /* Skeleton loading cards shown briefly on page load */
    .skeleton-card {
        border-radius: 1rem;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .skeleton-img {
        height: 20rem;
        border-radius: 1rem;
        background: linear-gradient(90deg, var(--footer-bg) 25%, var(--border-color) 50%, var(--footer-bg) 75%);
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.4s ease-in-out infinite;
    }

    .skeleton-line {
        height: 0.9rem;
        border-radius: 0.3rem;
        margin-top: 0.6rem;
        background: linear-gradient(90deg, var(--footer-bg) 25%, var(--border-color) 50%, var(--footer-bg) 75%);
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.4s ease-in-out infinite;
    }

    .skeleton-line.short {
        width: 50%;
    }

    @keyframes skeleton-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    #real-listings {
        display: none;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    #real-listings.visible {
        opacity: 1;
    }

    #scroll-loader {
        display: none;
        text-align: center;
        padding: 2rem 0;
        color: var(--text-muted);
    }

</style>

<div id="filters">
    <a href="/listings" class="filter-link">
        <div class="filter <%= !category ? 'active' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
    </a>
    <a href="/listings?category=Rooms" class="filter-link">
        <div class="filter <%= category === 'Rooms' ? 'active' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
    </a>
    <a href="/listings?category=Iconic cities" class="filter-link">
        <div class="filter <%= category === 'Iconic cities' ? 'active' : '' %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </div>
    </a>
    <a href="/listings?category=Mountains" class="filter-link">
        <div class="filter <%= category === 'Mountains' ? 'active' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
    </a>
    <a href="/listings?category=Castles" class="filter-link">
        <div class="filter <%= category === 'Castles' ? 'active' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
    </a>
    <a href="/listings?category=Amazing Pools" class="filter-link">
        <div class="filter <%= category === 'Amazing Pools' ? 'active' : '' %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
    </a>
    <a href="/listings?category=Camping" class="filter-link">
        <div class="filter <%= category === 'Camping' ? 'active' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
    </a>
    <a href="/listings?category=Farms" class="filter-link">
        <div class="filter <%= category === 'Farms' ? 'active' : '' %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
    </a>
    <a href="/listings?category=Arctic" class="filter-link">
        <div class="filter <%= category === 'Arctic' ? 'active' : '' %>">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
    </a>
    <a href="/listings?category=Domes" class="filter-link">
        <div class="filter <%= category === 'Domes' ? 'active' : '' %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </div>
    </a>
    <a href="/listings?category=Boats" class="filter-link">
        <div class="filter <%= category === 'Boats' ? 'active' : '' %>">
            <div><i class="fa-solid fa-ferry"></i></div>
            <p>Boats</p>
        </div>
    </a>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<% if (allListings.length === 0) { %>
    <div class="no-results">
        <i class="fa-solid fa-compass fa-2x mb-3"></i>
        <p>No listings found<% if (search) { %> for "<%= search %>"<% } %><% if (category) { %> in <%= category %><% } %>.</p>
        <a href="/listings" class="btn btn-dark">Clear filters</a>
    </div>
<% } %>

<!-- Skeleton placeholders shown briefly while the real listings fade in -->
<div id="skeleton-listings" class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-1 mt-3">
    <% for(let i = 0; i < 6; i++) { %>
        <div class="col">
            <div class="skeleton-card">
                <div class="skeleton-img"></div>
                <div class="skeleton-line"></div>
                <div class="skeleton-line short"></div>
            </div>
        </div>
    <% } %>
</div>

<div
    id="real-listings"
    class="row row-cols-lg-3 row-cols-mid-2 row-cols-sm-1 mt-3"
    data-has-more="<%= hasMore %>"
    data-next-page="<%= nextPage %>"
    data-category="<%= category || '' %>"
    data-search="<%= search || '' %>"
>
    <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <% if (listing.category) { %>
                        <span class="category-badge"><%= listing.category %></span><br>
                    <% } %>
                    <p class="card-text">
                        <b><%= listing.title %></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<div id="scroll-loader">
    <i class="fa-solid fa-circle-notch fa-spin"></i> Loading more stays...
</div>
<div id="scroll-sentinel"></div>

<script>
    let taxSwitch = document.getElementById('flexSwitchCheckDefault');
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName('tax-info');
        for(info of taxInfo) {
            if(taxSwitch.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    })

    // Show a brief skeleton-loading state before revealing the real listings
    const skeletonEl = document.getElementById('skeleton-listings');
    const realListingsEl = document.getElementById('real-listings');

    setTimeout(() => {
        skeletonEl.style.display = 'none';
        realListingsEl.style.display = 'flex';
        // Force a reflow so the opacity transition actually plays
        void realListingsEl.offsetWidth;
        realListingsEl.classList.add('visible');
    }, 600);

    // Infinite scroll: fetch and append more listings as the user nears the bottom
    let hasMore = realListingsEl.dataset.hasMore === 'true';
    let nextPage = parseInt(realListingsEl.dataset.nextPage, 10);
    const category = realListingsEl.dataset.category;
    const search = realListingsEl.dataset.search;
    const scrollLoader = document.getElementById('scroll-loader');
    let isLoading = false;

    function buildCard(listing) {
        const a = document.createElement('a');
        a.href = `/listings/${listing._id}`;
        a.className = 'listing-link';

        const categoryBadge = listing.category
            ? `<span class="category-badge">${listing.category}</span><br>`
            : '';

        a.innerHTML = `
            <div class="card col listing-card">
                <img src="${listing.image.url}" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    ${categoryBadge}
                    <p class="card-text">
                        <b>${listing.title}</b> <br>
                        &#8377; ${Number(listing.price).toLocaleString("en-IN")} / night
                        <i class="tax-info" style="display: ${taxSwitch.checked ? 'inline' : 'none'};"> &nbsp; &nbsp;+18% GST</i>
                    </p>
                </div>
            </div>
        `;
        return a;
    }

    async function loadMoreListings() {
        if (isLoading || !hasMore) return;
        isLoading = true;
        scrollLoader.style.display = 'block';

        try {
            const params = new URLSearchParams({ ajax: 'true', page: nextPage });
            if (category) params.set('category', category);
            if (search) params.set('search', search);

            const res = await fetch(`/listings?${params.toString()}`);
            const data = await res.json();

            data.listings.forEach((listing) => {
                realListingsEl.appendChild(buildCard(listing));
            });

            hasMore = data.hasMore;
            nextPage = data.nextPage;
        } catch (err) {
            console.error('Failed to load more listings:', err);
            hasMore = false; // stop retrying on error
        } finally {
            isLoading = false;
            scrollLoader.style.display = 'none';
        }
    }

    const sentinel = document.getElementById('scroll-sentinel');
    const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
            loadMoreListings();
        }
    }, { rootMargin: '300px' }); // start loading a bit before the sentinel is actually visible

    observer.observe(sentinel);
</script>